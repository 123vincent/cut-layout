    <variables>
        <variable description="Aisance totale sur le tour de poitrine" formula="6" name="#ais_poitrine"/>
        <variable description="Aisance sur chaque demi-carrure, dos et devant" formula="0.5" name="#ais_carrure"/>
        <variable description="Abaissement du fond d'emmanchure" formula="1.5" name="#ais_emm"/>
        <variable description="Aisance totale au poignet" formula="0" name="#ais_poignet"/>
        <variable description="Aisance totale au bassin" formula="6" name="#ais_bassin"/>
        <variable description="Pente d'épaule, modifiable sans toucher aux mesures (degrés)" formula="shoulder_slope_neck_side_angle" name="#pente_epaule"/>
        <variable description="Surlongueur de l'épaule dos, résorbée à la couture (0 en jersey)" formula="0" name="#embu_dos"/>
        <variable description="Correction de largeur d'encolure" formula="0.6" name="#corr_cou"/>
        <variable description="Hauteur du point d'encolure devant au-dessus du niveau de A" formula="1" name="#bascule_dev"/>
        <variable description="Supplément de profondeur d'encolure devant" formula="1" name="#creux_dev"/>
        <variable description="Diviseur de l'emmanchure donnant la hauteur de tête de manche" formula="3.5" name="#div_tete"/>
        <variable description="Coefficient qui rend la tête de manche dos égale à l'emmanchure dos" formula="0.9646" name="#k_tete_dos"/>
        <variable description="Coefficient qui rend la tête de manche devant égale à l'emmanchure devant" formula="0.9516" name="#k_tete_dev"/>
        <variable description="Longueur de la manche courte, du sommet M au bas" formula="22" name="#lg_manche_courte"/>
        <variable description="Rétrécissement du bas de la manche courte, de chaque côté" formula="1" name="#retrait_mc"/>
        <variable description="Excédent de demi-poitrine sur demi-taille (exemple: 6)" formula="(bust_circ + #ais_poitrine - waist_circ) /2" name="#exc_taille"/>
        <variable description="Excédent de demi-bassin sur demi-poitrine (exemple: 1)" formula="(hip_circ - bust_circ - #ais_poitrine) /2" name="#exc_bassin"/>
    </variables>
